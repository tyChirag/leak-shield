{
  "name": "leak-shield",
  "version": "0.1.0",
  "description": "Zero-dependency high-speed secret, token, and sensitive data redactor for logs, strings, and Node.js streams.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "redact",
    "mask",
    "secrets",
    "api-keys",
    "pii",
    "stream",
    "sanitize",
    "logging",
    "security"
  ],
  "author": "tyChirag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyChirag/leak-shield.git"
  },
  "homepage": "https://github.com/tyChirag/leak-shield#readme",
  "bugs": {
    "url": "https://github.com/tyChirag/leak-shield/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
